{
  "name": "monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:services": "turbo dev --filter=@repo/services",
    "dev:admin": "turbo dev --filter=@repo/admin",
    "build": "turbo build",
    "start": "npm --prefix apps/services/dist start",
    "typecheck": "turbo typecheck",
    "check": "pnpm format:check && turbo typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "gen:module": "pnpm --filter @repo/services gen:module",
    "db:push": "pnpm --filter @repo/services db:push",
    "db:push:dist": "npm --prefix apps/services/dist run db:push",
    "db:seed:admin": "pnpm --filter @repo/services db:seed:admin",
    "db:seed:permissions": "pnpm --filter @repo/services db:seed:permissions",
    "prepare:hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.11.10"
  }
}
