PORT=3030
HOST=0.0.0.0

TRUST_PROXY=false # 部署在 Nginx 等反向代理后面时设为 true，否则拿不到真实客户端 IP
BODY_LIMIT=1048576 # 请求体大小上限，单位：字节，默认 1MB

LOG_DIR=logs # 访问日志目录，日志文件格式为 YYYY-MM-DD.log
LOG_LEVEL=info # 日志级别：fatal / error / warn / info / debug / trace / silent

API_DOCS_ENABLED=true # 是否开放 /docs 接口文档，生产环境建议 false

REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=PREFIX:

APP_DATABASE_URL=postgres://postgres:123456@127.0.0.1:5432/server_demo

ADMIN_JWT_SECRET=dev-admin-secret-change-me # 管理后台 JWT 签名密钥
USER_JWT_SECRET=dev-user-secret-change-me # 用户端 JWT 签名密钥
JWT_ISSUER_ADMIN=admin-system # 管理后台 JWT issuer
JWT_ISSUER_USER=user-system # 用户端 JWT issuer
ACCESS_TOKEN_TTL=30m # access token 过期时间，例如 7d / 12h / 30m

UPLOAD_MAX_FILE_SIZE=10485760 # 上传文件大小限制，单位：字节，默认 10MB
