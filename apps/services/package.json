{
  "name": "@repo/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:module": "tsx scripts/gen_module.ts",
    "db:push": "node --env-file=.env --import tsx src/db/script/push-db.ts",
    "db:seed:admin": "node --env-file=.env --import tsx src/db/script/admin-user.ts",
    "db:seed:permissions": "node --env-file=.env --import tsx src/db/script/permissions.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/websocket": "^11.2.0",
    "@repo/shared": "workspace:*",
    "@scalar/fastify-api-reference": "^1.58.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "svg-captcha-fixed": "^1.5.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsc-alias": "1.9.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:"
  }
}
