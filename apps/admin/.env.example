# 复制成 .env.local 后按需修改（.env.local 不入库）

# 前端请求前缀。留空表示同源请求（开发期由 vite 代理转发，生产环境由 nginx 转发）
VITE_API_BASE=

# 开发代理目标。留空 / 不写时，vite 会自动读 apps/services 的 .env / .env.local / .env.example 里的 PORT，
# 只有后端和本机不在同一台机器、或想强制指定时才需要打开下面这一行
# VITE_PROXY_TARGET=http://localhost:3000

# 浏览器标签页标题
VITE_APP_TITLE=管理后台
