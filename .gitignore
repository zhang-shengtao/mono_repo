# 依赖与构建产物
node_modules
dist
logs
tmp
coverage

# 环境变量：真实配置不入库，只保留模板
.env
.env.*
!.env.example

# 构建与编辑器产物
*.tsbuildinfo
.DS_Store
.idea

# pnpm
.pnpm-debug.log*
.pnpm-store

# turborepo：本地缓存 + 运行日志
.turbo

# unplugin-vue-components 生成的组件类型声明（每次 dev/build 重新生成，不入库）
apps/admin/*.d.ts

# 本地源码快照备份（重建前的保险），不随仓库提交
.backup
